{
  "manifest_version": 3,
  "name": "Suno Recorder",
  "version": "0.2.0",
  "description": "Capture Suno playback to local audio file (webm).",
  "permissions": ["downloads", "activeTab", "scripting", "storage"],
  "host_permissions": ["https://*.suno.com/*", "https://suno.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" }
}
