{
  "manifest_version": 3,
  "name": "Suno Recorder",
  "version": "0.4.0",
  "description": "在 Suno 歌曲页面一键播放+录制，经本地宿主自动转 MP3。",
  "permissions": ["downloads", "activeTab", "scripting", "nativeMessaging", "notifications"],
  "host_permissions": ["https://*.suno.com/*", "https://suno.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "点此注入/重新注入录制按钮",
    "default_icon": "icon.png"
  },
  "icons": { "128": "icon.png" },
  "content_scripts": [
    {
      "matches": ["https://*.suno.com/*", "https://suno.com/*"],
      "js": ["content_iso.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
