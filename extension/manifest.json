{
  "manifest_version": 3,
  "name": "Suno Recorder",
  "version": "0.3.1",
  "description": "在 Suno 歌曲页面注入播放+录制按钮，一键录制为 webm。",
  "permissions": ["downloads", "activeTab", "scripting"],
  "host_permissions": ["https://*.suno.com/*", "https://suno.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "点此注入/重新注入录制按钮"
  },
  "content_scripts": [
    {
      "matches": ["https://*.suno.com/*", "https://suno.com/*"],
      "js": ["content_iso.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
